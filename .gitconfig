[color]
	ui = auto
[user]
	name = Yoshi Cheng-Hao Huang
	email = allstars.chh@gmail.com
[core]
    pager = delta
    editor = nvim
[interactive]
    diffFilter = delta --color-only
[delta]
    features = side-by-side line-numbers decorations
    whitespace-error-style = 22 reverse

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
[diff]
	context = 8
	wsErrorHighlight = all
[cinnabar]
	helper = /home/allstars/src/git-cinnabar/git-cinnabar-helper
	version-check = 1602160078
[alias]
	cp = cherry-pick
	cpcnt = cherry-pick --continue
	dc = diff --cached
	cm = commit
	br = branch
	bl = blame
	co = checkout
	st = status
	cma = commit --amend
	d = diff
	au = add -u
	ap = add -p
	lg = log
	ri = rebase -i
	cb = checkout -b
	so = show
  so1= show HEAD~1
  so2= show HEAD~2
  so3= show HEAD~3

	ss = show --stat
  ft = fetch origin main
	pl = pull origin mainb
  rb = rebase main
	rcnt = rebase --continue
	rcen = rebase central
	rv = revise -i
	cut = revise -c
    amcnt = am --continue
[cola]
	spellcheck = false
[sequence]
	editor = interactive-rebase-tool
[color "diff"]
	whitespace = red reverse
